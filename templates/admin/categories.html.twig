{% extends 'base.html.twig' %}

{% block title %}Catégories — Admin Mia Jewelry{% endblock %}

{% block body %}
<div style="max-width: 900px; margin: 40px auto; padding: 0 20px;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h1>Gestion des catégories</h1>
        <a href="{{ path('app_admin_category_new') }}"
           style="background: black; color: white; padding: 10px 20px; text-decoration: none;">
            + Nouvelle catégorie
        </a>
    </div>

    <a href="{{ path('app_admin') }}">← Retour au dashboard</a>

    <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
        <thead>
            <tr style="border-bottom: 2px solid #ccc;">
                <th style="text-align: left; padding: 10px;">Nom</th>
                <th style="text-align: left; padding: 10px;">Slug</th>
                <th style="text-align: left; padding: 10px;">Description</th>
                <th style="text-align: center; padding: 10px;">Produits</th>
                <th style="text-align: center; padding: 10px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for category in categories %}
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px;">{{ category.name }}</td>
                <td style="padding: 10px;">{{ category.slug }}</td>
                <td style="padding: 10px;">{{ category.description }}</td>
                <td style="text-align: center; padding: 10px;">
                    {{ category.products|length }}
                </td>
                <td style="text-align: center; padding: 10px;">
                    <a href="{{ path('app_admin_category_edit', {id: category.id}) }}"
                       style="margin-right: 10px;">
                        Modifier
                    </a>
                    <form method="post"
                          action="{{ path('app_admin_category_delete', {id: category.id}) }}"
                          style="display: inline;"
                          onsubmit="return confirm('Supprimer cette catégorie ?')">
                        <button type="submit"
                                style="color: red; background: none; border: none; cursor: pointer;">
                            Supprimer
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

</div>
{% endblock %}