{% extends 'base.html.twig' %}

{% block title %}Commandes — Admin Mia Jewelry{% endblock %}

{% block body %}
<div style="max-width: 1200px; margin: 40px auto; padding: 0 20px;">

    <h1>Gestion des commandes</h1>
    <a href="{{ path('app_admin') }}">← Retour au dashboard</a>

    <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
        <thead>
            <tr style="border-bottom: 2px solid #ccc;">
                <th style="text-align: left; padding: 10px;">N°</th>
                <th style="text-align: left; padding: 10px;">Client</th>
                <th style="text-align: left; padding: 10px;">Date</th>
                <th style="text-align: right; padding: 10px;">Total</th>
                <th style="text-align: center; padding: 10px;">Statut</th>
                <th style="text-align: center; padding: 10px;">Changer statut</th>
            </tr>
        </thead>
        <tbody>
            {% for order in orders %}
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px;">#{{ order.id }}</td>
                <td style="padding: 10px;">{{ order.user.fullName }}</td>
                <td style="padding: 10px;">{{ order.createdAt|date('d/m/Y H:i') }}</td>
                <td style="text-align: right; padding: 10px;">
                    {{ order.totalAmount|number_format(2, ',', ' ') }} €
                </td>
                <td style="text-align: center; padding: 10px;">
                    {{ order.statusLabel }}
                </td>
                <td style="text-align: center; padding: 10px;">
                    <form method="post"
                          action="{{ path('app_admin_order_status', {id: order.id}) }}">
                        <select name="status" style="padding: 5px;">
                            <option value="pending"   {{ order.status == 'pending'   ? 'selected' : '' }}>En attente</option>
                            <option value="paid"      {{ order.status == 'paid'      ? 'selected' : '' }}>Payée</option>
                            <option value="shipped"   {{ order.status == 'shipped'   ? 'selected' : '' }}>Expédiée</option>
                            <option value="delivered" {{ order.status == 'delivered' ? 'selected' : '' }}>Livrée</option>
                            <option value="cancelled" {{ order.status == 'cancelled' ? 'selected' : '' }}>Annulée</option>
                        </select>
                        <button type="submit"
                                style="background: black; color: white; padding: 5px 10px; border: none; cursor: pointer; margin-left: 5px;">
                            ✓
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

</div>
{% endblock %}