{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin — Mia Jewelry{% endblock %}

{% block body %}
<div style="max-width: 1200px; margin: 40px auto; padding: 0 20px;">

    <h1>⚙️ Dashboard Admin</h1>

    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 40px;">
        <div style="background: #f9f9f9; padding: 20px; text-align: center; border-radius: 8px;">
            <h2 style="font-size: 36px; margin: 0;">{{ totalProducts }}</h2>
            <p>Produits</p>
        </div>
        <div style="background: #f9f9f9; padding: 20px; text-align: center; border-radius: 8px;">
            <h2 style="font-size: 36px; margin: 0;">{{ totalOrders }}</h2>
            <p>Commandes</p>
        </div>
        <div style="background: #f9f9f9; padding: 20px; text-align: center; border-radius: 8px;">
            <h2 style="font-size: 36px; margin: 0;">{{ totalUsers }}</h2>
            <p>Utilisateurs</p>
        </div>
        <div style="background: #f9f9f9; padding: 20px; text-align: center; border-radius: 8px;">
            <h2 style="font-size: 36px; margin: 0;">{{ totalCategories }}</h2>
            <p>Catégories</p>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 40px;">
        <a href="{{ path('app_admin_products') }}" style="background: black; color: white; padding: 15px; text-align: center; text-decoration: none; border-radius: 8px;">
            Gérer les produits
        </a>
        <a href="{{ path('app_admin_categories') }}" style="background: black; color: white; padding: 15px; text-align: center; text-decoration: none; border-radius: 8px;">
            Gérer les catégories
        </a>
        <a href="{{ path('app_admin_orders') }}" style="background: black; color: white; padding: 15px; text-align: center; text-decoration: none; border-radius: 8px;">
            Gérer les commandes
        </a>
        <a href="{{ path('app_admin_users') }}" style="background: black; color: white; padding: 15px; text-align: center; text-decoration: none; border-radius: 8px;">
            Gérer les clients
</a>
    </div>

    <h2>Dernières commandes</h2>
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid #ccc;">
                <th style="text-align: left; padding: 10px;">N°</th>
                <th style="text-align: left; padding: 10px;">Client</th>
                <th style="text-align: left; padding: 10px;">Date</th>
                <th style="text-align: left; padding: 10px;">Statut</th>
                <th style="text-align: right; padding: 10px;">Total</th>
            </tr>
        </thead>
        <tbody>
            {% for order in recentOrders %}
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px;">#{{ order.id }}</td>
                <td style="padding: 10px;">{{ order.user.fullName }}</td>
                <td style="padding: 10px;">{{ order.createdAt|date('d/m/Y') }}</td>
                <td style="padding: 10px;">{{ order.statusLabel }}</td>
                <td style="text-align: right; padding: 10px;">{{ order.totalAmount }} €</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

</div>
{% endblock %}