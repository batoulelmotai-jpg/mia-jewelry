{% extends 'base.html.twig' %}

{% block title %}Produits — Admin Mia Jewelry{% endblock %}

{% block body %}
<div style="max-width: 1200px; margin: 40px auto; padding: 0 20px;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h1>Gestion des produits</h1>
        <a href="{{ path('app_admin_product_new') }}"
           style="background: black; color: white; padding: 10px 20px; text-decoration: none;">
            + Nouveau produit
        </a>
    </div>

    <a href="{{ path('app_admin') }}">← Retour au dashboard</a>

    <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
        <thead>
            <tr style="border-bottom: 2px solid #ccc;">
                <th style="text-align: left; padding: 10px;">Image</th>
                <th style="text-align: left; padding: 10px;">Nom</th>
                <th style="text-align: left; padding: 10px;">Catégorie</th>
                <th style="text-align: right; padding: 10px;">Prix</th>
                <th style="text-align: center; padding: 10px;">Stock</th>
                <th style="text-align: center; padding: 10px;">Actif</th>
                <th style="text-align: center; padding: 10px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px;">
                    {% if product.imageName %}
                        <img src="{{ asset('images/products/' ~ product.imageName) }}"
                             style="width: 60px; height: 60px; object-fit: cover;">
                    {% else %}
                        <div style="width: 60px; height: 60px; background: #eee; display: flex; align-items: center; justify-content: center; font-size: 10px;">
                            Pas d'image
                        </div>
                    {% endif %}
                </td>
                <td style="padding: 10px;">{{ product.name }}</td>
                <td style="padding: 10px;">{{ product.category.name }}</td>
                <td style="text-align: right; padding: 10px;">{{ product.price }} €</td>
                <td style="text-align: center; padding: 10px;">{{ product.stock }}</td>
                <td style="text-align: center; padding: 10px;">
                    {{ product.isActive ? '✅' : '❌' }}
                </td>
                <td style="text-align: center; padding: 10px;">
                    <a href="{{ path('app_admin_product_edit', {id: product.id}) }}"
                       style="margin-right: 10px;">
                        Modifier
                    </a>
                    <form method="post"
                          action="{{ path('app_admin_product_delete', {id: product.id}) }}"
                          style="display: inline;"
                          onsubmit="return confirm('Supprimer ce produit ?')">
                        <button type="submit" style="color: red; background: none; border: none; cursor: pointer;">
                            Supprimer
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

</div>
{% endblock %}