{% extends 'base.html.twig' %}

{% block title %}Mon Panier — Mia Jewelry{% endblock %}

{% block body %}
<div class="cart-container">

    <div class="section-title">
        <h2>Mon Panier</h2>
        {% if cart %}
            <p>{{ cart|length }} article(s)</p>
        {% endif %}
    </div>

    {% if cart %}

        <table class="cart-table">
            <thead>
                <tr>
                    <th colspan="2">Produit</th>
                    <th style="text-align:center;">Quantité</th>
                    <th style="text-align:right;">Prix unitaire</th>
                    <th style="text-align:right;">Sous-total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in cart %}
                <tr>
                    <td style="width:100px;">
                        {% if item.product.imageName %}
                            <img src="{{ asset('images/products/' ~ item.product.imageName) }}"
                                 class="cart-product-img">
                        {% else %}
                            <div class="cart-product-img" style="display:flex;align-items:center;justify-content:center;font-size:10px;color:#aaa;">
                                PHOTO
                            </div>
                        {% endif %}
                    </td>
                    <td>
                        <div style="font-size:12px;letter-spacing:1px;text-transform:uppercase;font-weight:500;">
                            {{ item.product.name }}
                        </div>
                        {% if item.product.material %}
                        <div style="font-size:11px;color:#888;margin-top:4px;">
                            {{ item.product.material }}
                        </div>
                        {% endif %}
                    </td>
                    <td style="text-align:center;">
                        <form method="post" action="{{ path('app_cart_update', {id: item.product.id}) }}"
                              style="display:flex;align-items:center;justify-content:center;gap:8px;">
                            <input type="number"
                                   name="quantity"
                                   value="{{ item.quantity }}"
                                   min="1"
                                   max="{{ item.product.stock }}"
                                   style="width:50px;text-align:center;padding:6px;border:1px solid #ddd;">
                            <button type="submit"
                                    style="background:none;border:1px solid #ddd;padding:6px 10px;cursor:pointer;font-size:12px;">
                                ✓
                            </button>
                        </form>
                    </td>
                    <td style="text-align:right;">{{ item.product.price }} €</td>
                    <td style="text-align:right;font-weight:600;">
                        {{ item.subtotal|number_format(2, ',', ' ') }} €
                    </td>
                    <td style="text-align:right;">
                        <a href="{{ path('app_cart_remove', {id: item.product.id}) }}"
                           style="font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#888;"
                           onclick="return confirm('Supprimer ce produit ?')">
                            Retirer
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <div style="display:flex;justify-content:space-between;align-items:center;padding:30px 0;border-top:2px solid #1a1a1a;margin-top:20px;">
            <a href="{{ path('app_catalogue') }}"
               style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#888;">
                ← Continuer mes achats
            </a>
            <div style="text-align:right;">
                <div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#888;margin-bottom:5px;">
                    Total
                </div>
                <div style="font-size:24px;font-weight:600;margin-bottom:20px;">
                    {{ total|number_format(2, ',', ' ') }} €
                </div>
                <div style="display:flex;gap:15px;justify-content:flex-end;">
                    <a href="{{ path('app_cart_clear') }}"
                       onclick="return confirm('Vider le panier ?')"
                       style="font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#888;padding:12px 20px;border:1px solid #ddd;">
                        Vider le panier
                    </a>
                    <a href="{{ path('app_order_checkout') }}" class="btn-primary">
                        Commander →
                    </a>
                </div>
            </div>
        </div>

    {% else %}

        <div style="text-align:center;padding:80px 0;">
            <p style="font-size:14px;letter-spacing:2px;text-transform:uppercase;color:#888;margin-bottom:30px;">
                Votre panier est vide
            </p>
            <a href="{{ path('app_catalogue') }}" class="btn-primary">
                Découvrir nos bijoux
            </a>
        </div>

    {% endif %}

</div>
{% endblock %}