{% extends 'base.html.twig' %}

{% block title %}Inscription — Mia Jewelry{% endblock %}

{% block body %}
<div class="form-container">

    <h1 class="form-title">Créer un compte</h1>

    {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}

        <div class="form-group">
            <label>Prénom</label>
            {{ form_widget(registrationForm.firstName, {'attr': {'placeholder': 'Votre prénom'}}) }}
        </div>

        <div class="form-group">
            <label>Nom</label>
            {{ form_widget(registrationForm.lastName, {'attr': {'placeholder': 'Votre nom'}}) }}
        </div>

        <div class="form-group">
            <label>Email</label>
            {{ form_widget(registrationForm.email, {'attr': {'placeholder': 'votre@email.com'}}) }}
        </div>

        <div class="form-group">
            <label>Mot de passe</label>
            {{ form_widget(registrationForm.plainPassword.first, {'attr': {'placeholder': 'Minimum 6 caractères'}}) }}
        </div>

        <div class="form-group">
            <label>Confirmer le mot de passe</label>
            {{ form_widget(registrationForm.plainPassword.second, {'attr': {'placeholder': 'Répétez le mot de passe'}}) }}
        </div>

        {% for error in registrationForm.vars.errors %}
            <p style="color:red;font-size:13px;">{{ error.message }}</p>
        {% endfor %}

        <button type="submit" class="btn-primary" style="width:100%;text-align:center;padding:14px;margin-top:10px;">
            Créer mon compte
        </button>

    {{ form_end(registrationForm) }}

    <p style="text-align:center;margin-top:25px;font-size:13px;color:#888;">
        Déjà un compte ?
        <a href="{{ path('app_login') }}" style="color:#1a1a1a;text-decoration:underline;">
            Se connecter
        </a>
    </p>

</div>
{% endblock %}