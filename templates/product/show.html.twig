{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} — Mia Jewelry{% endblock %}

{% block body %}
<div class="product-detail">

    <div class="product-detail-image">
        {% if product.imageName %}
            <img src="{{ asset('images/products/' ~ product.imageName) }}"
                 alt="{{ product.name }}">
        {% else %}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:12px;letter-spacing:2px;background:#f8f5f0;">
                PHOTO À VENIR
            </div>
        {% endif %}
    </div>

    <div class="product-detail-info">

        <a href="{{ path('app_catalogue') }}" style="font-size:12px;letter-spacing:1px;color:#888;text-transform:uppercase;">
            ← Retour au catalogue
        </a>

        <br><br>

        <div class="product-detail-category">
            {{ product.category.name }}
        </div>

        <h1 class="product-detail-name">{{ product.name }}</h1>

        <div class="product-detail-price">{{ product.price }} €</div>

        <hr class="product-detail-divider">

        {% if product.description %}
            <p class="product-detail-desc">{{ product.description }}</p>
        {% endif %}

        {% if product.material %}
            <p class="product-detail-meta">
                Matière : <strong>{{ product.material }}</strong>
            </p>
        {% endif %}

        <hr class="product-detail-divider">

        {% if product.stock > 0 %}
            <p style="font-size:13px;color:#2d7a2d;letter-spacing:1px;margin-bottom:25px;">
                ✓ En stock — {{ product.stock }} disponibles
            </p>

            <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}">
                <div class="quantity-selector">
                    <label style="font-size:11px;letter-spacing:2px;text-transform:uppercase;">
                        Quantité
                    </label>
                    <input type="number" name="quantity" value="1"
                           min="1" max="{{ product.stock }}">
                </div>

                <button type="submit" class="btn-primary"
                        style="width:100%;text-align:center;padding:16px;font-size:13px;letter-spacing:2px;">
                    Ajouter au panier
                </button>
            </form>

            <div style="margin-top:15px;text-align:center;">
                <a href="{{ path('app_order_checkout') }}"
                   class="btn-secondary"
                   style="display:block;text-align:center;padding:14px;">
                    Commander directement
                </a>
            </div>

        {% else %}
            <p style="font-size:13px;color:#c0392b;letter-spacing:1px;text-transform:uppercase;">
                ✗ Rupture de stock
            </p>
        {% endif %}

        <hr class="product-detail-divider">

        <div style="display:flex;gap:30px;">
            <div style="text-align:center;">
                <div style="font-size:20px;margin-bottom:5px;">🚚</div>
                <div style="font-size:11px;letter-spacing:1px;color:#888;text-transform:uppercase;">
                    Livraison offerte<br>dès 80€
                </div>
            </div>
            <div style="text-align:center;">
                <div style="font-size:20px;margin-bottom:5px;">↩️</div>
                <div style="font-size:11px;letter-spacing:1px;color:#888;text-transform:uppercase;">
                    Retours<br>gratuits
                </div>
            </div>
            <div style="text-align:center;">
                <div style="font-size:20px;margin-bottom:5px;">🔒</div>
                <div style="font-size:11px;letter-spacing:1px;color:#888;text-transform:uppercase;">
                    Paiement<br>sécurisé
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}