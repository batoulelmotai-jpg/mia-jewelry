{% extends 'base.html.twig' %}

{% block title %}Catalogue — Mia Jewelry{% endblock %}

{% block body %}
<div class="container" style="padding-top: 40px;">

    <div class="section-title">
        <h2>Nos Bijoux</h2>
        <p>{{ products|length }} produits disponibles</p>
    </div>

    {% if categories %}
    <div style="display: flex; justify-content: center; gap: 30px; margin-bottom: 40px; flex-wrap: wrap;">
    <a href="{{ path('app_catalogue') }}"
       style="font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
       color: {% if not currentCategory %}#1a1a1a{% else %}#888{% endif %};
       border-bottom: {% if not currentCategory %}2px solid black{% else %}none{% endif %};
       padding-bottom: 3px;">
        Tous
    </a>
    {% for category in categories %}
    <a href="{{ path('app_catalogue', {category: category.slug}) }}"
       style="font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
       color: {% if currentCategory and currentCategory.slug == category.slug %}#1a1a1a{% else %}#888{% endif %};
       border-bottom: {% if currentCategory and currentCategory.slug == category.slug %}2px solid black{% else %}none{% endif %};
       padding-bottom: 3px;">
        {{ category.name }}
    </a>
    {% endfor %}
</div>
    {% endif %}

    {% if products %}
    <div class="products-grid">
        {% for product in products %}
        <a href="{{ path('app_product_show', {id: product.id}) }}" class="product-card">
            <div class="product-card-image">
                {% if product.imageName %}
                    <img src="{{ asset('images/products/' ~ product.imageName) }}"
                         alt="{{ product.name }}">
                {% else %}
                    <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:12px;letter-spacing:1px;">
                        PHOTO À VENIR
                    </div>
                {% endif %}
                {% if product.stock < 5 and product.stock > 0 %}
                    <span class="product-card-badge">Dernières pièces</span>
                {% endif %}
            </div>
            <div class="product-card-info">
                <div class="product-card-name">{{ product.name }}</div>
                {% if product.material %}
                    <div class="product-card-material">{{ product.material }}</div>
                {% endif %}
                <div class="product-card-price">{{ product.price }} €</div>
            </div>
        </a>
        {% endfor %}
    </div>
    {% else %}
        <div style="text-align:center; padding: 80px 0; color: #888;">
            <p style="font-size: 14px; letter-spacing: 2px; text-transform: uppercase;">
                Aucun produit disponible
            </p>
        </div>
    {% endif %}

</div>
{% endblock %}