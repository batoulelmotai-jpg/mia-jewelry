{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil — Mia Jewelry{% endblock %}

{% block body %}
<div class="form-container">

    <h1 class="form-title">Mon profil</h1>

    <form method="post">

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
            <div class="form-group">
                <label>Prénom</label>
                <input type="text" name="firstName"
                       value="{{ user.firstName }}" required>
            </div>
            <div class="form-group">
                <label>Nom</label>
                <input type="text" name="lastName"
                       value="{{ user.lastName }}" required>
            </div>
        </div>

        <div class="form-group">
            <label>Email</label>
            <input type="email" value="{{ user.email }}" disabled
                   style="background: #f8f5f0; color: #888;">
            <small style="font-size: 11px; color: #888;">L'email ne peut pas être modifié</small>
        </div>

        <div class="form-group">
            <label>Téléphone</label>
            <input type="text" name="phone"
                   value="{{ user.phone ?? '' }}"
                   placeholder="06 12 34 56 78">
        </div>

        <div class="form-group">
            <label>Adresse de livraison</label>
            <textarea name="address" rows="3"
                      placeholder="123 rue de la Paix, 75001 Paris">{{ user.address ?? '' }}</textarea>
        </div>

        <button type="submit" class="btn-primary"
                style="width: 100%; text-align: center; padding: 14px;">
            Enregistrer
        </button>

    </form>

    <p style="text-align: center; margin-top: 20px;">
        <a href="{{ path('app_account') }}" style="font-size: 13px; color: #888;">
            ← Retour à mon compte
        </a>
    </p>

</div>
{% endblock %}