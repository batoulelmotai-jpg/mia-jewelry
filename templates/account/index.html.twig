{% extends 'base.html.twig' %}

{% block title %}Mon compte — Mia Jewelry{% endblock %}

{% block body %}
<div class="container" style="padding: 60px 40px;">

    <div class="section-title">
        <h2>Mon compte</h2>
        <p>Bienvenue, {{ user.firstName }} ✦</p>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 40px; max-width: 900px; margin: 0 auto;">

        <div style="background: #f8f5f0; padding: 30px;">
            <div style="text-align: center; margin-bottom: 25px;">
                <div style="width: 80px; height: 80px; background: #1a1a1a; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px; color: white; font-size: 28px; font-family: var(--font-titre);">
                    {{ user.firstName|first|upper }}
                </div>
                <div style="font-size: 16px; font-weight: 500;">{{ user.fullName }}</div>
                <div style="font-size: 13px; color: #888; margin-top: 5px;">{{ user.email }}</div>
            </div>

            <ul style="list-style: none; border-top: 1px solid #e8e0d8; padding-top: 20px;">
                <li style="margin-bottom: 12px;">
                    <a href="{{ path('app_account') }}"
                       style="font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: #1a1a1a; font-weight: 500;">
                        Mon profil
                    </a>
                </li>
                <li style="margin-bottom: 12px;">
                    <a href="{{ path('app_order_history') }}"
                       style="font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: #888;">
                        Mes commandes
                    </a>
                </li>
                <li style="margin-bottom: 12px;">
                    <a href="{{ path('app_account_edit') }}"
                       style="font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: #888;">
                        Modifier mon profil
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_logout') }}"
                       style="font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: #888;">
                        Déconnexion
                    </a>
                </li>
            </ul>
        </div>

        <div>
            <h3 style="font-size: 12px; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 25px;">
                Mes informations
            </h3>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
                <div>
                    <div style="font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #888; margin-bottom: 5px;">Prénom</div>
                    <div style="font-size: 15px;">{{ user.firstName }}</div>
                </div>
                <div>
                    <div style="font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #888; margin-bottom: 5px;">Nom</div>
                    <div style="font-size: 15px;">{{ user.lastName }}</div>
                </div>
                <div>
                    <div style="font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #888; margin-bottom: 5px;">Email</div>
                    <div style="font-size: 15px;">{{ user.email }}</div>
                </div>
                <div>
                    <div style="font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #888; margin-bottom: 5px;">Téléphone</div>
                    <div style="font-size: 15px;">{{ user.phone ?? 'Non renseigné' }}</div>
                </div>
            </div>

            <div style="margin-bottom: 30px;">
                <div style="font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #888; margin-bottom: 5px;">Adresse</div>
                <div style="font-size: 15px;">{{ user.address ?? 'Non renseignée' }}</div>
            </div>

            <a href="{{ path('app_account_edit') }}" class="btn-secondary">
                Modifier mes informations
            </a>
        </div>

    </div>
</div>
{% endblock %}