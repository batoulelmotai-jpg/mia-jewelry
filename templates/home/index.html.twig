{% extends 'base.html.twig' %}

{% block title %}Mia Jewelry — Bijoux élégants{% endblock %}

{% block body %}

<section class="hero">
    <div class="hero-image hero-image-main" style="background: #2a2a2a;">
        <img src="{{ asset('images/hero/hero-main.jpg') }}" alt="Mia Jewelry Collection">
        <div class="hero-overlay">
            <h1>Mia Jewelry</h1>
            <p>Collection Printemps 2026</p>
            <a href="{{ path('app_catalogue') }}" class="btn-primary">Découvrir</a>
        </div>
    </div>
    <div class="hero-image" style="background: #1a1a1a;">
        <img src="{{ asset('images/hero/hero-side.jpg') }}" alt="Nouveautés">
        <div class="hero-overlay">
            <p>Nouveautés</p>
        </div>
    </div>
</section>

<div class="container">
    <div class="section-title" style="margin-top: 60px;">
        <h2>Nos Collections</h2>
        <p>Découvrez nos bijoux faits avec passion</p>
    </div>
</div>

<div class="categories-grid">
    <a href="{{ path('app_catalogue', {category: 'colliers'}) }}" class="category-card">
        <img src="{{ asset('images/categories/colliers.jpg') }}" alt="Colliers">
        <div class="category-label">Colliers</div>
    </a>
    <a href="{{ path('app_catalogue', {category: 'bracelets'}) }}" class="category-card">
        <img src="{{ asset('images/categories/bracelets.jpg') }}" alt="Bracelets">
        <div class="category-label">Bracelets</div>
    </a>
    <a href="{{ path('app_catalogue', {category: 'boucles-oreilles'}) }}" class="category-card">
        <img src="{{ asset('images/categories/boucles.jpg') }}" alt="Boucles d'oreilles">
        <div class="category-label">Boucles</div>
    </a>
    <a href="{{ path('app_catalogue', {category: 'bagues'}) }}" class="category-card">
        <img src="{{ asset('images/categories/bagues.jpg') }}" alt="Bagues">
        <div class="category-label">Bagues</div>
    </a>
</div>

<div class="container">
    <div class="section-title">
        <h2>Nouveautés</h2>
        <p>Les dernières pièces de notre collection</p>
    </div>
</div>

{% endblock %}